# ── VirusTotal ────────────────────────────────────────────────────────────────
VT_API_KEY=your_virustotal_api_key_here

# ── Azure AD / Entra ID (App Registration) ────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-app-client-id-here
AZURE_CLIENT_SECRET=your-app-client-secret-here
AZURE_DOMAIN=corp.com

# ── Slack (optional — for P1 paging) ─────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── TheHive ───────────────────────────────────────────────────────────────────
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=your_thehive_api_key_here

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/wazuh-triage

# ── Wazuh ─────────────────────────────────────────────────────────────────────
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_API_PASSWORD=MyS3cr3tAPIPass
